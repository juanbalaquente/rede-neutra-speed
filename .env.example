# Copie para .env. Nunca versione o .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://rede:rede@localhost:5433/rede_neutra
POSTGRES_PASSWORD=rede

# Portas no seu PC (docker compose). Mude se já estiverem em uso.
WEB_PORT=8088
DB_PORT=5433

# Gere com: openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=8
RESERVATION_HOURS=48

# mock = rede de exemplo; wiki = API versionada da SpeedWiki (caminho de produção);
# real = Codemaps/OLTCloud/Voalle direto, só de um servidor liberado por IP.
INTEGRATIONS_MODE=mock
# Só com INTEGRATIONS_MODE=mock: teste = 3 CTOs; demo = rede de demonstração (~40 CTOs nas siglas R1, ITA, FAT).
MOCK_NETWORK=teste

# Modo wiki. A chave nunca vai para arquivo versionado.
WIKI_BASE_URL=
WIKI_API_KEY=

CODEMAPS_TOKEN=
CODEMAPS_SECRET=
OLTCLOUD_BASE=https://speedfibra.oltcloud.co
OLTCLOUD_USER=
OLTCLOUD_PASS=
VOALLE_ERP_URL=
VOALLE_CLIENT_ID=
VOALLE_CLIENT_SECRET=
VOALLE_SYNDATA=

# Usados só pelo seed
SEED_ADMIN_EMAIL=admin@speed.local
SEED_ADMIN_PASSWORD=

# Produção (docker-compose.prod.yml): domínio do portal, com DNS apontando para o servidor.
PORTAL_DOMAIN=

# Liberacao de ONU (ESCRITA em producao). off (padrao) | mock | wiki. So ligar com validacao do Juan.
ACTIVATION_MODE=off
WIKI_WRITE_KEY=

# Fotos de campo: pasta dentro do container (volume photos-data, entra no backup) e tamanho maximo.
# PUBLIC_BASE_URL monta o link assinado completo para a Infra (ex.: https://portal.exemplo.com.br).
PHOTO_MAX_MB=8
PUBLIC_BASE_URL=

# Segundo fator (TOTP) para supervisor e administrador. Em producao e obrigatorio por padrao; em dev/teste fica desligado.
# MFA_REQUIRED=true|false forca o valor. TOTP_KEY cifra os segredos no banco: defina UMA VEZ (openssl rand -hex 32)
# ANTES de alguem configurar o 2FA. Sem ela, usa o SESSION_SECRET (e trocar o SESSION_SECRET quebraria todos os 2FA).
MFA_REQUIRED=
TOTP_KEY=

# Automacoes do cliente final (bloquear, desbloquear, reiniciar, cancelar): ESCRITA em producao. off (padrao) | mock | wiki.
# So ligar com validacao do Juan e depois que a Wiki entregar as rotas v3. Usa WIKI_BASE_URL e WIKI_WRITE_KEY.
AUTOMATION_MODE=off

# Status do cliente na rede (semaforo e sinal de 30 dias), SO LEITURA. off (padrao) | mock | wiki. Usa WIKI_BASE_URL e WIKI_API_KEY.
# Chamados e automacoes ficam em AUTOMATION_MODE; aqui nao ha escrita.
CLIENT_STATUS_MODE=off

# Criacao automatica do contrato no Voalle pela Wiki (ESCRITA em producao). off (padrao: contrato digitado) | mock | wiki.
# So ligar com validacao do Juan, depois que a Wiki entregar POST /v3/contratos. Usa WIKI_BASE_URL e WIKI_WRITE_KEY.
CONTRACT_MODE=off
