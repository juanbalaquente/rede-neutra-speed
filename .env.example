# Copie para .env. Nunca versione o .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://rede:rede@localhost:5433/rede_neutra
POSTGRES_PASSWORD=rede

# Portas no seu PC (docker compose). Mude se já estiverem em uso.
WEB_PORT=8088
DB_PORT=5433

# Gere com: openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=8
RESERVATION_HOURS=48

# mock = rede de exemplo; real = Codemaps/OLTCloud/Voalle de verdade.
# real só funciona de um servidor liberado por IP nesses sistemas.
INTEGRATIONS_MODE=mock

CODEMAPS_TOKEN=
CODEMAPS_SECRET=
OLTCLOUD_BASE=https://speedfibra.oltcloud.co
OLTCLOUD_USER=
OLTCLOUD_PASS=
VOALLE_ERP_URL=
VOALLE_CLIENT_ID=
VOALLE_CLIENT_SECRET=
VOALLE_SYNDATA=

# Usados só pelo seed
SEED_ADMIN_EMAIL=admin@speed.local
SEED_ADMIN_PASSWORD=
