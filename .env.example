# Copie para .env. Nunca versione o .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://rede:rede@localhost:5433/rede_neutra
POSTGRES_PASSWORD=rede

# Portas no seu PC (docker compose). Mude se já estiverem em uso.
WEB_PORT=8088
DB_PORT=5433

# Gere com: openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=8
RESERVATION_HOURS=48

# mock = rede de exemplo; wiki = API versionada da SpeedWiki (caminho de produção);
# real = Codemaps/OLTCloud/Voalle direto, só de um servidor liberado por IP.
INTEGRATIONS_MODE=mock

# Modo wiki. A chave nunca vai para arquivo versionado.
WIKI_BASE_URL=
WIKI_API_KEY=

CODEMAPS_TOKEN=
CODEMAPS_SECRET=
OLTCLOUD_BASE=https://speedfibra.oltcloud.co
OLTCLOUD_USER=
OLTCLOUD_PASS=
VOALLE_ERP_URL=
VOALLE_CLIENT_ID=
VOALLE_CLIENT_SECRET=
VOALLE_SYNDATA=

# Usados só pelo seed
SEED_ADMIN_EMAIL=admin@speed.local
SEED_ADMIN_PASSWORD=
